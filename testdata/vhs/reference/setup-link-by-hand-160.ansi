[38;2;115;129;155;48;2;46;52;64mCLAUDE LINK  [m[38;2;76;86;106;48;2;46;52;64m───────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────[m
[48;2;46;52;64m                                                                                                                                                                [m
[48;2;46;52;64m  [m[38;2;229;233;240;48;2;46;52;64mThe claude command starts Claude Code through switchboard, so every session is routed.                                                                        [m
[48;2;46;52;64m                                                                                                                                                                [m
[48;2;46;52;64m  [m[1;38;2;167;196;146;48;2;46;52;64m✓  [m[38;2;229;233;240;48;2;46;52;64mLink                 [m[38;2;147;158;178;48;2;46;52;64m~/.local/share/switchboard/bin/claude → switchboard                                                                                   [m
[48;2;46;52;64m                                                                                                                                                                [m
[48;2;46;52;64m  [m[1;38;2;235;203;139;48;2;46;52;64m!  [m[38;2;229;233;240;48;2;46;52;64mYour shell           [m[38;2;147;158;178;48;2;46;52;64mruns Claude Code's own claude, ~/.local/bin/claude, so its sessions aren't routed                                                     [m
[48;2;46;52;64m                                                                                                                                                                [m
[48;2;46;52;64m                                                                                                                                                                [m
[48;2;46;52;64m  [m[38;2;229;233;240;48;2;46;52;64mAdd this line to your shell's startup file yourself, after anything else there that changes PATH:                                                             [m
[48;2;46;52;64m                                                                                                                                                                [m
[48;2;46;52;64m      [m[38;2;136;192;208;48;2;46;52;64mif [ -r "$HOME/.local/share/switchboard/shell/init.zsh" ]; then . "$HOME/.local/share/switchboard/shell/init.zsh"; fi  # switchboard                      [m
[48;2;46;52;64m                                                                                                                                                                [m
[48;2;46;52;64m  [m[38;2;229;233;240;48;2;46;52;64mOr, where you keep your PATH another way, put this directory first on it:                                                                                     [m
[48;2;46;52;64m                                                                                                                                                                [m
[48;2;46;52;64m      [m[38;2;136;192;208;48;2;46;52;64m$HOME/.local/share/switchboard/bin                                                                                                                        [m
[48;2;46;52;64m                                                                                                                                                                [m
[48;2;46;52;64m  [m[38;2;147;158;178;48;2;46;52;64mThen press r: setup asks your shell again, as a new terminal would start it.                                                                                  [m
