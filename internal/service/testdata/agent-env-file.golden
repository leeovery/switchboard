<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>io.github.leeovery.switchboard</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/zsh</string>
		<string>-c</string>
		<string>source "$1" &amp;&amp; exec "$2" serve "${@:3}"</string>
		<string>switchboard</string>
		<string>/Users/tester/.config/tokens.env</string>
		<string>/opt/homebrew/bin/switchboard</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/Users/tester/.local/state/switchboard/logs/launchd.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/tester/.local/state/switchboard/logs/launchd.log</string>
</dict>
</plist>
