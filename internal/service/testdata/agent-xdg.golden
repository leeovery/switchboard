<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>io.github.leeovery.switchboard</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/zsh</string>
		<string>-f</string>
		<string>-c</string>
		<string>source "$1" &amp;&amp; exec "$2" serve "${@:3}"</string>
		<string>switchboard</string>
		<string>/Users/tester/.config/tokens.env</string>
		<string>/opt/homebrew/bin/switchboard</string>
		<string>--config</string>
		<string>/Users/tester/switchboard &amp; co/config.toml</string>
		<string>--log-level</string>
		<string>debug</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>XDG_CONFIG_HOME</key>
		<string>/Users/tester/.config</string>
		<key>XDG_STATE_HOME</key>
		<string>/Users/tester/.local/state</string>
		<key>SWITCHBOARD_CONFIG</key>
		<string>/Users/tester/.config/switchboard/work.toml</string>
		<key>SWITCHBOARD_LOG_LEVEL</key>
		<string>warn</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ExitTimeOut</key>
	<integer>45</integer>
	<key>StandardOutPath</key>
	<string>/Users/tester/.local/state/switchboard/logs/launchd.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/tester/.local/state/switchboard/logs/launchd.log</string>
</dict>
</plist>
