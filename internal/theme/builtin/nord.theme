# Nord (nordtheme.com): the dashboard's palette from the start, and the dark
# half of the default pair.
#
# Its 19 base tokens port Nord. Two of Nord's colours are corrected, each as
# little as it takes to read as text must: state.destructive against this
# canvas, and state.positive against the selection too. Three Nord lacks are
# invented: text.muted and text.subtle, between its bright greys and its dark
# ones, and bg.attention, a faint blend of its yellow into the canvas,
# settled by eye. The bars fill along the dashboard's ramp from before
# themes: Nord's Aurora green, yellow, orange and red.

# Text, bright to faint.
text.primary = #ECEFF4
text.secondary = #E5E9F0
text.tertiary = #D8DEE9
text.muted = #939EB2
text.subtle = #73819B
text.faint = #4C566A
text.on-selection = #FFFFFF

# Accents and states.
accent.primary = #B48EAD
accent.key = #81A1C1
accent.mode = #88C0D0
accent.attention = #EBCB8B
state.positive = #A7C492
state.destructive = #DD8188

# Surfaces, and the text drawn on the attention surface.
canvas = #2E3440
bg.selection = #434C5E
bg.attention = #3D4046
bg.subtle = #3B4252
border = #4C566A
text.on-attention = #ECEFF4

# The bars' ramp.
viz.ramp.1 = #A3BE8C
viz.ramp.2 = #EBCB8B
viz.ramp.3 = #D08770
viz.ramp.4 = #BF616A
