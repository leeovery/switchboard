function claude { '/usr/local/bin/switchboard' --config '/Users/tester/it'\''s my/config.toml' run -- "$@"; }
function cxwork { '/usr/local/bin/switchboard' --config '/Users/tester/it'\''s my/config.toml' run --account work -- "$@"; }
function cxpersonal { '/usr/local/bin/switchboard' --config '/Users/tester/it'\''s my/config.toml' run --account personal -- "$@"; }
function cxside { '/usr/local/bin/switchboard' --config '/Users/tester/it'\''s my/config.toml' run --account side -- "$@"; }
