#!/usr/bin/env bash
#
# Builds a release's binaries on this Mac, signed with its Developer ID and
# notarised, before mint tags it: mint's pre_tag runs it after scripts/gated,
# with the version about to be tagged in MINT_NEW_VERSION. It builds HEAD in a
# checkout of its own outside the repository, for arm64 and amd64, signs each,
# sends both to Apple's notary service and waits on its answer, for about an
# hour at most, then archives and sums them under the names the Homebrew
# formula reads, and keeps them, with the commit built, in
# ~/Library/Caches/switchboard/release/<version>/, in place of any other
# version's, for scripts/release-upload once the release is made. Any failure
# exits non-zero, so mint stops before the tag. It runs each binary to check
# its version, so it needs an Apple-silicon Mac with Rosetta.
#
# By hand it builds the version given, as scripts/release-build 0.0.0-check,
# which checks signing and notarising without releasing anything; a ref after
# the version builds that ref, as scripts/release-upload builds a tag's tree.
# Each run logs to ~/Library/Logs/switchboard/release-<version>.log.
set -euo pipefail

scripts=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
# shellcheck source=scripts/release-common
. "$scripts/release-common"

identifier=io.github.leeovery.switchboard
identity="Developer ID Application"
profile=switchboard
# notarytool waits on Apple this many seconds at a time, this many times at
# most, so mint, which gives a hook no time limit, waits about an hour.
notary_wait=900
notary_waits=4
work=

usage() {
	release_fail "Usage: scripts/release-build [<version> [<ref>]]"
}

check_platform() {
	[[ $(uname -s) == Darwin ]] || release_fail "release-build signs with macOS's codesign and notarytool: run it on a Mac."
}

check_version() {
	[[ -n $1 ]] || release_fail "No version to build: mint gives it as MINT_NEW_VERSION; by hand, give it, as scripts/release-build 0.0.0-check."
	release_valid_version "$1" || release_fail "$1 isn't a version, as 1.2.3 or 1.2.3-check."
}

# check_head checks that HEAD is what mint is about to tag $1 on: tracked
# files with nothing uncommitted, as untracked ones never reach a build of
# the commit, and no tag $1 yet.
check_head() {
	[[ -z $(git status --porcelain --untracked-files=no) ]] || release_fail "The checkout has changes: release-build builds HEAD, so commit or remove them."
	if git rev-parse -q --verify "refs/tags/$1" >/dev/null; then
		release_fail "$1 is tagged already, so HEAD isn't what's to be tagged: build the tag, as scripts/release-build ${1#v} $1."
	fi
}

# commit_of is the commit ref $1 names.
commit_of() {
	git rev-parse -q --verify "$1^{commit}" || release_fail "$1 names no commit to build."
}

check_identity() {
	local count
	count=$(security find-identity -v -p codesigning | grep -c "\"$identity: ") || true
	case $count in
	0) release_fail "The keychain has no valid $identity certificate to sign with: add it, with its private key, to the login keychain." ;;
	1) ;;
	*) release_fail "The keychain has $count valid $identity certificates, and codesign can't choose one: remove all but one." ;;
	esac
}

check_profile() {
	if ! xcrun notarytool history --keychain-profile "$profile" >/dev/null; then
		release_fail "notarytool can't use the keychain profile $profile, as it says above. If the profile isn't made, make it with xcrun notarytool store-credentials $profile; a locked keychain, or no network, fails the same way."
	fi
}

# arch_flag is arch(1)'s name for Go's arch $1.
arch_flag() {
	case $1 in
	amd64) echo x86_64 ;;
	*) echo "$1" ;;
	esac
}

# build builds version $2 from the checkout $1 for arch $3 into $4.
build() {
	(cd "$1" && CGO_ENABLED=0 GOOS=darwin GOARCH=$3 go build -trimpath \
		-ldflags "-s -w -X main.version=$2" -o "$4" ./cmd/switchboard)
}

sign() {
	codesign --force --options runtime --timestamp --identifier "$identifier" --sign "$identity" "$1" ||
		release_fail "codesign couldn't sign $1, as it says above. The login keychain may be locked, as over SSH (security unlock-keychain), or macOS may be asking on the Mac's screen to let codesign use the key."
}

# cant_run says why the binary $1, built for arch $2, doesn't run here, and
# what puts that right, and stops.
cant_run() {
	if [[ $(sysctl -in hw.optional.arm64) != 1 ]]; then
		release_fail "$1 doesn't run on this Intel Mac, so its version can't be checked: a release needs an Apple-silicon Mac with Rosetta."
	fi
	if [[ $2 == amd64 ]] && ! arch -x86_64 /usr/bin/true 2>/dev/null; then
		release_fail "$1 needs Rosetta to run, so its version can't be checked: install it with softwareupdate --install-rosetta --agree-to-license."
	fi
	release_fail "$1 doesn't run here, so its version can't be checked."
}

# check_binary checks the signature of the binary $1, built for arch $2, and
# that it reports version $3.
check_binary() {
	local details reported
	codesign --verify --strict "$1" || release_fail "$1's signature doesn't verify."
	details=$(codesign --display --verbose=2 "$1" 2>&1)
	if ! grep -qx "Identifier=$identifier" <<<"$details" ||
		! grep -q "^Authority=$identity: " <<<"$details" ||
		! grep -q "^CodeDirectory .*(runtime)" <<<"$details"; then
		echo "$details"
		release_fail "$1 isn't signed as $identifier by a $identity, with the hardened runtime."
	fi
	reported=$(arch "-$(arch_flag "$2")" "$1" --version) || cant_run "$1" "$2"
	[[ $reported == "switchboard version $3" ]] || release_fail "$1 reports \"$reported\", not switchboard version $3."
}

# field is the field $1 of notarytool's JSON answer $2; nothing when it has
# none.
field() {
	plutil -extract "$1" raw -o - - <<<"$2" 2>/dev/null || true
}

# notarise sends the folder $1 to Apple's notary service, zipped as $2, and
# waits on its answer.
notarise() {
	local result id status="In Progress" round started elapsed
	ditto -c -k --keepParent "$1" "$2"
	echo "Sending the binaries to Apple's notary service…"
	result=$(xcrun notarytool submit "$2" --keychain-profile "$profile" --no-wait --output-format json || true)
	id=$(field id "$result")
	if [[ -z $id ]]; then
		echo "$result"
		release_fail "notarytool gave no submission id, as its output above says: xcrun notarytool history --keychain-profile $profile shows what Apple has."
	fi
	local again="xcrun notarytool wait $id --keychain-profile $profile says when Apple has answered, and mint can then be run again."
	for ((round = 1; round <= notary_waits; round++)); do
		echo "Submission $id: waiting on Apple's answer…"
		started=$(release_now)
		result=$(xcrun notarytool wait "$id" --keychain-profile "$profile" --timeout "$notary_wait" --output-format json || true)
		elapsed=$(($(release_now) - started))
		status=$(field status "$result")
		# A wait that ran its time ends with no answer, or in progress; one
		# with no answer well before then failed, as on a locked keychain or
		# with no network, and waiting again would only fail again.
		if [[ -z $status ]] && ((elapsed < notary_wait - 60)); then
			echo "$result"
			release_fail "notarytool's wait on submission $id failed after $elapsed seconds, as it says above: $again"
		fi
		status=${status:-In Progress}
		[[ $status == "In Progress" ]] || break
	done
	echo "Submission $id: $status"
	if [[ $status == "In Progress" ]]; then
		release_fail "Apple hasn't answered submission $id in about an hour: $again"
	fi
	if [[ $status != Accepted ]]; then
		xcrun notarytool log "$id" --keychain-profile "$profile" || true
		release_fail "Apple's notary service refused the binaries, as its log above says."
	fi
}

# archive archives the binary $1 alone, named switchboard, into $2.
archive() {
	COPYFILE_DISABLE=1 tar --create --gzip --file "$2" --format ustar \
		--no-mac-metadata --no-xattrs --no-acls --no-fflags \
		--uid 0 --gid 0 --uname root --gname wheel \
		--directory "$(dirname "$1")" switchboard
}

# sum writes the checksums file of version $1's archives in the folder $2.
sum() {
	local names=() arch
	for arch in "${release_arches[@]}"; do
		names+=("$(release_archive "$1" "$arch")")
	done
	(cd "$2" && shasum -a 256 "${names[@]}" | LC_ALL=C sort -k 2) >"$2/$(release_checksums "$1")"
}

# keep keeps the folder $1 as version $2's, in place of what's kept for any
# version: one release is made at a time, and an upload of another that
# finds nothing kept builds it again from its tag.
keep() {
	local kept
	kept=$(release_kept "$2")
	rm -rf "$(dirname "$kept")"
	mkdir -p "$(dirname "$kept")"
	mv "$1" "$kept"
	echo "Kept in $kept:"
	ls -l "$kept"
}

# clean_up removes the checkout built from, and the rest of $work.
clean_up() {
	git worktree remove --force "$work/tree" 2>/dev/null || true
	rm -rf "$work"
}

main() {
	[[ $# -le 2 ]] || usage
	check_platform
	local version ref=${2:-} tag
	if [[ $# -ge 1 ]]; then
		version=$1
		tag=v$version
	else
		version=${MINT_NEW_VERSION:-}
		tag=${MINT_VERSION_TAG:-v$version}
	fi
	check_version "$version"
	cd "$scripts/.."
	release_log release-build "$version"
	if [[ -z $ref ]]; then
		check_head "$tag"
		ref=HEAD
	fi
	local commit
	commit=$(commit_of "$ref")
	check_identity
	check_profile

	work=$(mktemp -d)
	trap clean_up EXIT
	git worktree add --quiet --detach "$work/tree" "$commit"
	echo "Building switchboard $version from $commit"

	local arch bin out=$work/out
	mkdir "$work/bin" "$out"
	for arch in "${release_arches[@]}"; do
		bin=$work/bin/darwin_$arch/switchboard
		build "$work/tree" "$version" "$arch" "$bin"
		sign "$bin"
		check_binary "$bin" "$arch" "$version"
	done
	notarise "$work/bin" "$work/notarise.zip"
	for arch in "${release_arches[@]}"; do
		archive "$work/bin/darwin_$arch/switchboard" "$out/$(release_archive "$version" "$arch")"
	done
	sum "$version" "$out"
	echo "$commit" >"$out/commit"
	keep "$out" "$version"
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
	main "$@"
fi
