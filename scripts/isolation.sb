;; The macOS sandbox scripts/test-isolated runs the tests in: nothing beyond
;; this machine, no unix socket outside the temporary directory and nothing on
;; the router's port, no writes into the home directory but Go's caches, nor
;; into switchboard's real config, themes, state, preferences and bin
;; directory, or Claude Code's config directory, wherever they are, or the
;; directories on PATH, and none of the real programs tests must never run.
;;
;; Parameters, each a path with its symlinks resolved, as the sandbox matches
;; resolved paths:
;;   HOME        the home directory
;;   TMPDIR      the temporary directory
;;   GOCACHE     go env GOCACHE
;;   GOMODCACHE  go env GOMODCACHE
;;   CONFIG      the config file switchboard reads
;;   CONFIG_DIR  its config directory
;;   THEMES_DIR  its themes directory
;;   STATE_DIR   its state directory
;;   PREFS       its preferences file, the dashboard's, in the state directory
;;   BIN_DIR     its bin directory, which holds the claude link
;;   CLAUDE_DIR  Claude Code's config directory, where switchboard's skill goes
;;   PATH_DIRS   the directories on PATH outside the home, where a program
;;               run by name is found, joined by colons, as PATH joins them

(version 1)
(debug deny)
(allow default)

(define (home-literal path) (literal (string-append (param "HOME") path)))
(define (home-subpath path) (subpath (string-append (param "HOME") path)))

;; Loopback alone, and unix sockets in the temporary directory alone, where
;; the tests make theirs: not a live router's control socket, nor any other
;; program's. The sandbox's localhost is 127.0.0.1 and ::1, and macOS gives
;; loopback no other address. Nothing else needs a socket: every test passes,
;; building from an empty Go cache (tried).
(deny network-outbound)
(allow network-outbound
  (remote ip "localhost:*")
  (remote unix-socket (subpath (param "TMPDIR"))))
;; Nor the live router's control socket, in the real state directory, should
;; that be in the temporary directory.
(deny network-outbound (remote unix-socket (subpath (param "STATE_DIR"))))

;; Nor the router's port, either way: a live router listens there, and while
;; it's down, what listened in its place would be sent real sessions' tokens.
(deny network-bind (local ip "*:4747"))
(deny network-outbound (remote ip "*:4747"))

(deny file-write* (subpath (param "HOME")))
(allow file-write* (subpath (param "GOCACHE")) (subpath (param "GOMODCACHE")))
;; The real config, themes, state, preferences and bin directory, and Claude
;; Code's config directory, where the environment puts them, home or not, and
;; where a link to one leads.
(deny file-write*
  (literal (param "CONFIG"))
  (subpath (param "CONFIG_DIR"))
  (subpath (param "THEMES_DIR"))
  (subpath (param "STATE_DIR"))
  (literal (param "PREFS"))
  (subpath (param "BIN_DIR"))
  (subpath (param "CLAUDE_DIR")))

;; The directories on PATH outside the home, such as /opt/homebrew/bin, where
;; a claude put by mistake would be found ahead of the real one: those in the
;; home are in the home's rule.
(define (split text)
  (let loop ((chars (string->list text)) (field '()) (fields '()))
    (let ((done (lambda () (cons (list->string (reverse field)) fields))))
      (cond
        ((null? chars) (reverse (done)))
        ((char=? (car chars) #\:) (loop (cdr chars) '() (done)))
        (else (loop (cdr chars) (cons (car chars) field) fields))))))
(for-each
  (lambda (dir)
    (if (> (string-length dir) 0)
      (deny file-write* (subpath dir))))
  (split (param "PATH_DIRS")))

;; A rule here matches the file a symlink resolves to, not the link (proven by
;; experiment), so each install is denied where its real file lands. The
;; stubs testguard puts on PATH match none of these, and still run.
(deny process-exec
  ;; Claude Code, wherever internal/claude looks for it. The native installer
  ;; links ~/.local/bin/claude to a version under ~/.local/share/claude; the
  ;; old local install lives in ~/.claude/local; Homebrew's cask and npm link
  ;; /opt/homebrew/bin/claude or /usr/local/bin/claude into their own trees.
  (home-literal "/.local/bin/claude")
  (home-subpath "/.local/share/claude")
  (home-subpath "/.claude/local")
  (literal "/opt/homebrew/bin/claude")
  (literal "/usr/local/bin/claude")
  (regex #"/Caskroom/claude-code/")
  (regex #"/node_modules/@anthropic-ai/claude-code")
  ;; Notifications, launchd, and opening files and URLs.
  (literal "/usr/bin/osascript")
  (literal "/bin/launchctl")
  (literal "/usr/bin/open")
  ;; tmux: the system's, or Homebrew's, linked into its Cellar.
  (literal "/usr/bin/tmux")
  (literal "/usr/local/bin/tmux")
  (literal "/opt/homebrew/bin/tmux")
  (regex #"/Cellar/tmux/"))
